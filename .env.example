# ======================================================
# DevPulse backend environment template
# Copy to ".env" and adjust values for your environment.
# ======================================================

# -----------------------------
# Bot
# -----------------------------
# URL used by bot to call scrapper API.
BOT_SCRAPPER_URL=http://scrapper:8081
# Bot datasource JDBC URL (compose profile).
BOT_POSTGRES_URL=jdbc:postgresql://bot-db:5432/devpulse_bot
# Bot Postgres username.
BOT_POSTGRES_USER=postgres
# Bot Postgres password.
BOT_POSTGRES_PASSWORD=postgres
# Bot database name for compose stateful service.
BOT_POSTGRES_DB_NAME=devpulse_bot
# Bot Redis host.
BOT_REDIS_HOST=redis
# Bot Redis port.
BOT_REDIS_PORT=6379
# Bot Redis password (empty means no auth).
BOT_REDIS_PASSWORD=
# Bot Redis logical database index.
BOT_REDIS_DATABASE=1
# Bot Kafka bootstrap servers.
BOT_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Bot Kafka topic for link updates.
BOT_LINK_UPDATES_TOPIC=link-updates
# Bot Kafka consumer group for link updates.
BOT_LINK_UPDATES_GROUP_ID=bot-link-updates-consumer
# Retry interval in ms for Kafka consumer retries.
BOT_KAFKA_RETRY_INTERVAL=1000
# Retry multiplier for exponential backoff.
BOT_KAFKA_RETRY_MULTIPLIER=2.0
# Max retry delay in ms.
BOT_KAFKA_RETRY_MAX_DELAY=5000
# Max retry attempts.
BOT_KAFKA_RETRY_MAX_ATTEMPTS=3
# Allow Kafka retry topics auto creation.
BOT_KAFKA_RETRY_AUTO_CREATE_TOPICS=true
# Firebase project id for FCM HTTP v1.
BOT_FCM_PROJECT_ID=replace-with-firebase-project-id
# Path to service account JSON file mounted in runtime.
BOT_FCM_CREDENTIALS_PATH=/run/secrets/bot-fcm-service-account.json
# Optional custom template for FCM HTTP v1 endpoint.
BOT_FCM_ENDPOINT_TEMPLATE=https://fcm.googleapis.com/v1/projects/%s/messages:send
# Max push retry attempts.
BOT_PUSH_MAX_ATTEMPTS=3
# Initial push retry delay in milliseconds.
BOT_PUSH_INITIAL_DELAY_MS=1000
# Exponential backoff multiplier for push retries.
BOT_PUSH_BACKOFF_MULTIPLIER=2.0
# Max push retry delay in milliseconds.
BOT_PUSH_MAX_DELAY_MS=5000
# Token lifecycle API rate limit per minute.
BOT_PUSH_TOKEN_RATE_LIMIT_PER_MINUTE=60

# -----------------------------
# Scrapper
# -----------------------------
# URL used by scrapper to call bot API.
SCRAPPER_BOT_URL=http://bot:8080
# Scrapper datasource JDBC URL (compose profile).
SCRAPPER_POSTGRES_URL=jdbc:postgresql://scrapper-db:5432/devpulse_scrapper
# Scrapper Postgres username.
SCRAPPER_POSTGRES_USER=postgres
# Scrapper Postgres password.
SCRAPPER_POSTGRES_PASSWORD=postgres
# Scrapper database name for compose stateful service.
SCRAPPER_POSTGRES_DB_NAME=devpulse_scrapper
# Scrapper Redis host.
SCRAPPER_REDIS_HOST=redis
# Scrapper Redis port.
SCRAPPER_REDIS_PORT=6379
# Scrapper Redis password (empty means no auth).
SCRAPPER_REDIS_PASSWORD=
# Scrapper Redis logical database index.
SCRAPPER_REDIS_DATABASE=0
# Enable scrapper Redis cache.
SCRAPPER_REDIS_CACHE_ENABLED=true
# ETag cache TTL (e.g. 6h, 30m).
SCRAPPER_REDIS_ETAG_TTL=6h
# Poll hint cache TTL (e.g. 30m, 1h).
SCRAPPER_REDIS_POLL_HINT_TTL=30m
# Scrapper Kafka bootstrap servers.
SCRAPPER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Delivery mode between scrapper and bot: http or kafka.
SCRAPPER_DELIVERY_MODE=http
# Outbox topic used in kafka mode.
SCRAPPER_OUTBOX_TOPIC=link-updates
# Outbox flush interval.
SCRAPPER_OUTBOX_INTERVAL=5s
# Outbox batch size.
SCRAPPER_OUTBOX_BATCH_SIZE=100
# Internal auth header for scrapper endpoints.
SCRAPPER_AUTH_HEADER=X-Internal-Secret

# -----------------------------
# Infra (shared fallbacks)
# -----------------------------
# Shared generic Postgres JDBC URL fallback.
POSTGRES_URL=jdbc:postgresql://localhost:5432/devpulse
# Shared generic Postgres username fallback.
POSTGRES_USER=postgres
# Shared generic Postgres password fallback.
POSTGRES_PASSWORD=postgres
# Shared generic Redis host fallback.
REDIS_HOST=localhost
# Shared generic Redis port fallback.
REDIS_PORT=6379
# Shared generic Redis password fallback.
REDIS_PASSWORD=
# Shared generic Redis database fallback.
REDIS_DATABASE=0
# Shared generic Kafka bootstrap servers fallback.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Generic bot URL fallback.
BOT_URL=http://localhost:8080
# Generic scrapper URL fallback.
SCRAPPER_URL=http://localhost:8081

# -----------------------------
# Security
# -----------------------------
# Shared secret for internal bot <-> scrapper calls.
INTERNAL_SHARED_SECRET=devpulse-internal-secret
# Internal auth header name used by bot.
INTERNAL_SHARED_HEADER=X-Internal-Secret

# -----------------------------
# External APIs
# -----------------------------
# Required GitHub API token for scrapper.
GITHUB_TOKEN=replace-with-github-token
# Required StackOverflow app key.
SO_TOKEN_KEY=replace-with-stackoverflow-key
# Required StackOverflow access token.
SO_ACCESS_TOKEN=replace-with-stackoverflow-access-token
